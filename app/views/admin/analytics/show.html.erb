<% content_for :title, "実績分析" %>
<% staff_axis = @axis == "staff" %>

<h1 class="text-2xl font-bold">実績分析</h1>

<div class="flex flex-wrap items-center justify-between gap-3">
  <nav aria-label="分析軸" class="flex flex-wrap gap-2">
    <% ResultSummary::AXES.each do |axis, label| %>
      <%= render "admin/shared/filter_tab", label: label, path: admin_analytics_path(axis: axis, month: @month.strftime("%Y-%m")), selected: @axis == axis %>
    <% end %>
  </nav>
  <%= form_with url: admin_analytics_path, method: :get, class: "flex items-center gap-2" do |form| %>
    <%= form.hidden_field :axis, value: @axis %>
    <%= form.month_field :month, value: @month.strftime("%Y-%m"), class: "input w-auto", aria: { label: "対象月" } %>
    <%= form.submit "表示", name: nil, class: "btn btn-secondary" %>
  <% end %>
</div>

<p class="text-[13px] text-slate-600">
  <%= @axis == "month" ? "#{(@month << 5).year}年#{(@month << 5).month}月〜#{@month.year}年#{@month.month}月" : "#{@month.year}年#{@month.month}月" %>の集計です。
  最終報告がある日は確定値、ない日は最新の中間報告を暫定値として使います。
  <%= staff_axis ? "スタッフ別は本人の獲得件数の合計です。" : "達成率はブース予算に対する割合です。" %>
</p>

<% if @rows.any? %>
  <% max = @rows.map(&:acquired).max %>
  <section class="rounded-xl border border-slate-200 bg-white p-5" aria-label="獲得件数のグラフ">
    <div class="mb-3 flex flex-wrap gap-x-4 gap-y-1 text-xs text-slate-600">
      <span class="inline-flex items-center gap-1.5"><span aria-hidden="true" class="size-2.5 rounded-sm bg-chart-1"></span>獲得件数</span>
      <% unless staff_axis %>
        <span class="inline-flex items-center gap-1.5"><span aria-hidden="true" class="h-0.5 w-3.5 bg-slate-700"></span>ブース予算</span>
      <% end %>
    </div>
    <div class="flex flex-col gap-2">
      <% scale = [ max, @rows.map(&:target).max ].max.nonzero? || 1 %>
      <% @rows.each do |row| %>
        <div class="grid grid-cols-[8rem_1fr_4rem] items-center gap-3 text-[13px]">
          <span class="truncate font-semibold"><%= row.label %></span>
          <div class="relative h-4">
            <div class="absolute inset-y-0 left-0 rounded-r bg-chart-1" style="width: <%= row.acquired * 100 / scale %>%"></div>
            <% if row.target.positive? %>
              <div aria-hidden="true" class="absolute -inset-y-1 w-0.5 bg-slate-700" style="left: <%= row.target * 100 / scale %>%"></div>
            <% end %>
          </div>
          <span class="text-right tabular-nums"><%= row.acquired %>件</span>
        </div>
      <% end %>
    </div>
  </section>
<% end %>

<div class="overflow-hidden rounded-xl border border-slate-200 bg-white">
  <% if @rows.empty? %>
    <p class="px-4 py-8 text-center text-slate-500">この期間の報告はありません。</p>
  <% else %>
    <div class="overflow-x-auto">
      <table class="w-full min-w-200 text-[13px]">
        <thead>
          <tr class="border-b border-slate-200 text-left text-xs text-slate-600">
            <th scope="col" class="px-4 py-2.5 font-semibold"><%= ResultSummary::AXES[@axis].delete_suffix("別") %></th>
            <th scope="col" class="px-4 py-2.5 text-right font-semibold">獲得件数</th>
            <% unless staff_axis %>
              <th scope="col" class="px-4 py-2.5 text-right font-semibold">ブース予算</th>
              <th scope="col" class="px-4 py-2.5 text-right font-semibold">達成率</th>
            <% end %>
            <th scope="col" class="px-4 py-2.5 text-right font-semibold">アプローチ</th>
            <th scope="col" class="px-4 py-2.5 text-right font-semibold">カード</th>
            <th scope="col" class="px-4 py-2.5 text-right font-semibold">カード率</th>
            <th scope="col" class="px-4 py-2.5 font-semibold">状態</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @rows.each do |row| %>
            <tr>
              <th scope="row" class="px-4 py-3 text-left font-semibold whitespace-nowrap"><%= row.label %></th>
              <td class="px-4 py-3 text-right font-semibold tabular-nums"><%= row.acquired %>件</td>
              <% unless staff_axis %>
                <td class="px-4 py-3 text-right tabular-nums"><%= row.target %>件</td>
                <td class="px-4 py-3 text-right tabular-nums"><%= format_rate(row.achievement_rate) %></td>
              <% end %>
              <td class="px-4 py-3 text-right tabular-nums"><%= row.approach %>件</td>
              <td class="px-4 py-3 text-right tabular-nums"><%= row.card %>件</td>
              <td class="px-4 py-3 text-right tabular-nums"><%= format_rate(row.card_rate) %></td>
              <td class="px-4 py-3"><%= row.provisional ? status_badge("暫定を含む", :warning) : status_badge("確定", :good) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
