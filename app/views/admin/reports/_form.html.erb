<%# locals: (report:, work_session:, result_rows:) %>
<% registered_reports = work_session.reports.select(&:persisted?).sort_by(&:report_slot) %>
<% assigned_users = work_session.work_assignments.sort_by(&:id).map(&:user) %>
<% other_users = User.where(is_active: true).where.not(id: assigned_users.map(&:id)).order(:name) %>
<% reporter_groups = [ [ "この稼働予定のスタッフ", assigned_users.map { |user| [ user.name, user.id ] } ],
                       [ "その他のスタッフ", other_users.map { |user| [ user.name, user.id ] } ] ].reject { |_, options| options.empty? } %>

<div class="flex flex-wrap items-center justify-between gap-3">
  <div>
    <h1 class="text-2xl font-bold">実績の登録</h1>
    <p class="mt-1 text-[13px] text-slate-600"><%= date_with_wday(work_session.work_date) %>・<%= work_session.display_name %></p>
  </div>
  <%= link_to "別の稼働予定を選ぶ", new_admin_report_path(date: work_session.work_date), class: "btn btn-secondary" %>
</div>

<section aria-label="稼働予定の概要" class="max-w-3xl rounded-xl border border-slate-200 bg-white px-6 py-4">
  <dl class="grid gap-x-6 gap-y-1 text-[13px] sm:grid-cols-[auto_1fr]">
    <dt class="text-slate-500">ブース予算</dt>
    <dd class="tabular-nums"><%= work_session.budget_count ? "#{work_session.budget_count}件" : "未設定" %></dd>
    <dt class="text-slate-500">スタッフ</dt>
    <dd><%= work_session.work_assignments.size %>名・個人目標の合計 <span class="tabular-nums"><%= work_session.target_count %>件</span></dd>
    <dt class="text-slate-500">登録済みの報告</dt>
    <dd class="flex flex-wrap gap-1.5">
      <% if registered_reports.empty? %>
        まだありません
      <% else %>
        <% registered_reports.each do |registered_report| %>
          <%= status_badge("#{registered_report.report_slot}時 #{Report.human_attribute_name("report_type.#{registered_report.report_type}")}", registered_report.final? ? :good : :warning) %>
        <% end %>
      <% end %>
    </dd>
  </dl>
</section>

<div class="max-w-3xl rounded-xl border border-slate-200 bg-white p-6">
  <%= form_with model: [ :admin, report ], class: "flex flex-col gap-5" do |form| %>
    <%= form.hidden_field :work_session_id %>

    <% if report.errors.any? %>
      <div class="rounded-lg border border-critical/30 bg-critical-bg px-4 py-3 text-critical-text">
        <p class="font-semibold"><%= report.errors.count %>件のエラーがあります。</p>
        <ul class="mt-1 list-disc pl-5">
          <% report.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="grid gap-5 sm:grid-cols-2">
      <fieldset>
        <legend class="mb-1 font-semibold"><%= Report.human_attribute_name(:report_type) %></legend>
        <div class="flex flex-wrap gap-x-5 gap-y-2 py-2">
          <% Report.report_types.each_key do |report_type| %>
            <label class="inline-flex items-center gap-2">
              <%= form.radio_button :report_type, report_type, class: "size-4 accent-blue-600" %>
              <%= Report.human_attribute_name("report_type.#{report_type}") %>
            </label>
          <% end %>
        </div>
        <p class="mt-1 text-xs text-slate-500">中間報告の獲得件数はその時点までの累計です。最終報告でその日の実績が確定します。</p>
      </fieldset>

      <fieldset>
        <legend class="mb-1 font-semibold"><%= Report.human_attribute_name(:report_slot) %></legend>
        <div class="flex flex-wrap gap-x-5 gap-y-2 py-2">
          <% Report::SLOTS.each do |slot| %>
            <% registered = registered_reports.any? { |registered_report| registered_report.report_slot == slot } %>
            <label class="inline-flex items-center gap-2 <%= "text-slate-400" if registered %>">
              <%= form.radio_button :report_slot, slot, disabled: registered, class: "size-4 accent-blue-600" %>
              <%= slot %>時<% if registered %><span class="text-xs">（登録済み）</span><% end %>
            </label>
          <% end %>
        </div>
        <p class="mt-1 text-xs text-slate-500">同じ時刻の報告は、1つの稼働予定に1件だけ登録できます。</p>
      </fieldset>

      <div>
        <%= form.label :submitted_by_id, class: "mb-1 block font-semibold" %>
        <%= form.select :submitted_by_id, grouped_options_for_select(reporter_groups, report.submitted_by_id), { prompt: "選択してください" }, required: true, class: "input" %>
      </div>

      <div>
        <%= form.label :reported_at, class: "mb-1 block font-semibold" %>
        <%= form.datetime_local_field :reported_at, include_seconds: false, required: true, class: "input" %>
      </div>
    </div>

    <fieldset>
      <legend class="mb-2 font-semibold"><%= Report.human_attribute_name(:report_results) %></legend>
      <div class="overflow-x-auto rounded-lg border border-slate-200">
        <table class="w-full min-w-150 text-[13px]">
          <thead class="bg-slate-50">
            <tr class="text-left text-xs text-slate-600">
              <th scope="col" class="px-3 py-2 font-semibold">スタッフ</th>
              <th scope="col" class="px-3 py-2 text-right font-semibold">個人目標</th>
              <th scope="col" class="px-3 py-2 font-semibold"><%= ReportResult.human_attribute_name(:acquired_count) %></th>
              <th scope="col" class="px-3 py-2 font-semibold"><%= ReportResult.human_attribute_name(:approach_count) %><span class="ml-1.5 font-normal text-slate-500">任意</span></th>
              <th scope="col" class="px-3 py-2 font-semibold"><%= ReportResult.human_attribute_name(:card_count) %><span class="ml-1.5 font-normal text-slate-500">任意</span></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <%= form.fields_for :report_results, result_rows do |result_form| %>
              <% work_assignment = result_form.object.work_assignment %>
              <% staff_name = work_assignment.user.name %>
              <tr>
                <th scope="row" class="px-3 py-2 text-left font-semibold whitespace-nowrap">
                  <%= result_form.hidden_field :work_assignment_id %>
                  <%= staff_name %>
                </th>
                <td class="px-3 py-2 text-right tabular-nums whitespace-nowrap"><%= work_assignment.target_count %>件</td>
                <% { acquired_count: "の獲得件数", approach_count: "のアプローチ数", card_count: "のカード数" }.each do |attribute, suffix| %>
                  <td class="px-3 py-2">
                    <div class="flex items-center gap-2">
                      <%= result_form.number_field attribute, min: 0, step: 1, class: "input w-24 text-right tabular-nums", aria: { label: "#{staff_name}#{suffix}" } %>
                      <span class="text-slate-600">件</span>
                    </div>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <p class="mt-1 text-xs text-slate-500">獲得件数を入力したスタッフだけが登録されます（1回の報告につき最大<%= Report::MAX_RESULTS %>名）。アプローチ数とカード数は分かる場合だけ入力してください。</p>
    </fieldset>

    <div class="flex gap-2 pt-1">
      <%= form.submit class: "btn btn-primary" %>
      <%= link_to "キャンセル", admin_reports_path(date: work_session.work_date), class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>
