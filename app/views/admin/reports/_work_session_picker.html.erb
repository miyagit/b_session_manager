<%# locals: (date:, work_sessions:) %>
<div>
  <h1 class="text-2xl font-bold">実績の登録</h1>
  <p class="mt-1 text-[13px] text-slate-600">実績を登録する稼働予定を選んでください。</p>
</div>

<div class="flex flex-wrap items-center gap-2">
  <%= link_to "前日", new_admin_report_path(date: date.yesterday), class: "btn btn-secondary" %>
  <%= form_with url: new_admin_report_path, method: :get, class: "flex items-center gap-2" do |form| %>
    <%= form.date_field :date, value: date, class: "input w-auto", aria: { label: "稼働日" } %>
    <%= form.submit "表示", name: nil, class: "btn btn-secondary" %>
  <% end %>
  <%= link_to "翌日", new_admin_report_path(date: date.tomorrow), class: "btn btn-secondary" %>
  <%= link_to "今日", new_admin_report_path, class: "btn btn-secondary" unless date == Date.current %>
</div>

<h2 class="text-lg font-bold"><%= date_with_wday(date) %></h2>

<div class="overflow-hidden rounded-xl border border-slate-200 bg-white">
  <% if work_sessions.empty? %>
    <div class="flex flex-col items-center gap-3 px-4 py-8 text-slate-500">
      <p>この日の稼働予定はありません。</p>
      <%= link_to "稼働予定を作成", new_admin_work_session_path(date: date), class: "btn btn-secondary" %>
    </div>
  <% else %>
    <div class="overflow-x-auto">
      <table class="w-full min-w-200 text-[13px]">
        <thead>
          <tr class="border-b border-slate-200 text-left text-xs text-slate-600">
            <th scope="col" class="px-4 py-2.5 font-semibold">ブース</th>
            <th scope="col" class="px-4 py-2.5 font-semibold">スタッフ（個人目標）</th>
            <th scope="col" class="px-4 py-2.5 font-semibold">報告状況</th>
            <th scope="col" class="px-4 py-2.5 font-semibold"><span class="sr-only">操作</span></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% work_sessions.each do |work_session| %>
            <% registered_slots = work_session.reports.map(&:report_slot).sort %>
            <tr>
              <th scope="row" class="px-4 py-3 text-left whitespace-nowrap">
                <span class="font-semibold"><%= work_session.display_name %></span>
                <p class="mt-0.5 text-xs font-normal text-slate-500">
                  <%= WorkLocation.human_attribute_name("category.#{work_session.work_location.category}") %>・ブース予算 <%= work_session.budget_count ? "#{work_session.budget_count}件" : "未設定" %>
                </p>
              </th>
              <td class="px-4 py-3 text-slate-700">
                <% if work_session.work_assignments.any? %>
                  <%= work_session.work_assignments.sort_by(&:id).map { |work_assignment| "#{work_assignment.user.name} #{work_assignment.target_count}件" }.join("、") %>
                <% else %>
                  <span class="text-slate-500">スタッフが割り当てられていません</span>
                <% end %>
              </td>
              <td class="px-4 py-3 whitespace-nowrap">
                <%= result_status_badge(work_session.result_status) %>
                <% if registered_slots.any? %>
                  <span class="ml-1 text-xs text-slate-500"><%= registered_slots.map { |slot| "#{slot}時" }.join("・") %> 登録済み</span>
                <% end %>
              </td>
              <td class="px-4 py-3 text-right whitespace-nowrap">
                <% if work_session.work_assignments.empty? %>
                  <%= link_to "スタッフを割り当てる", edit_admin_work_session_path(work_session), class: "btn btn-secondary" %>
                <% elsif (Report::SLOTS - registered_slots).empty? %>
                  <span class="text-slate-500">全時間帯登録済み</span>
                <% else %>
                  <%= link_to "この稼働予定で登録", new_admin_report_path(work_session_id: work_session), class: "btn btn-primary" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
