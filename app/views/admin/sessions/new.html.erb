<% content_for :title, "ログイン" %>

<div class="mx-auto mt-6 w-full max-w-sm rounded-xl border border-slate-200 bg-white p-6">
  <h1 class="mb-5 text-xl font-bold">管理画面ログイン</h1>

  <%= form_with model: resource, scope: resource_name, url: session_path(resource_name), class: "flex flex-col gap-4" do |form| %>
    <div>
      <%= form.label :email, class: "mb-1 block font-semibold" %>
      <%= form.email_field :email, autofocus: true, autocomplete: "email", required: true, class: "input" %>
    </div>

    <div>
      <%= form.label :password, class: "mb-1 block font-semibold" %>
      <%= form.password_field :password, autocomplete: "current-password", required: true, class: "input" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="flex items-center gap-2">
        <%= form.check_box :remember_me, class: "size-4 accent-blue-600" %>
        <%= form.label :remember_me %>
      </div>
    <% end %>

    <%= form.submit "ログイン", class: "btn btn-primary mt-2 w-full py-2" %>
  <% end %>
</div>
