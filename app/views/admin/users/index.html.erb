<% content_for :title, "スタッフ一覧" %>

<div class="flex flex-wrap items-center justify-between gap-3">
  <h1 class="text-2xl font-bold">スタッフ一覧</h1>
  <%= link_to "新規登録", new_admin_user_path, class: "btn btn-primary" %>
</div>

<div class="overflow-hidden rounded-xl border border-slate-200 bg-white">
  <% if @users.any? %>
    <div class="overflow-x-auto">
      <table class="w-full min-w-160 text-[13px]">
        <thead>
          <tr class="border-b border-slate-200 text-left text-xs text-slate-600">
            <th scope="col" class="px-4 py-2.5 font-semibold"><%= User.human_attribute_name(:name) %></th>
            <th scope="col" class="px-4 py-2.5 font-semibold"><%= User.human_attribute_name(:line_uid) %></th>
            <th scope="col" class="px-4 py-2.5 font-semibold"><%= User.human_attribute_name(:role) %></th>
            <th scope="col" class="px-4 py-2.5 font-semibold">状態</th>
            <th scope="col" class="px-4 py-2.5"><span class="sr-only">操作</span></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @users.each do |user| %>
            <tr>
              <th scope="row" class="px-4 py-3 text-left font-semibold whitespace-nowrap"><%= user.name %></th>
              <td class="px-4 py-3"><code class="rounded bg-slate-100 px-1.5 py-0.5 text-xs text-slate-700"><%= user.line_uid %></code></td>
              <td class="px-4 py-3">
                <span class="<%= user.admin? ? "bg-blue-50 text-blue-700" : "bg-slate-100 text-slate-700" %> rounded-full px-2.5 py-0.5 text-xs font-semibold"><%= User.human_attribute_name("role.#{user.role}") %></span>
              </td>
              <td class="px-4 py-3">
                <% if user.active? %>
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-good-bg px-2.5 py-0.5 text-xs font-semibold text-good-text"><span aria-hidden="true" class="size-1.5 rounded-full bg-good"></span>有効</span>
                <% else %>
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-600"><span aria-hidden="true" class="size-1.5 rounded-full bg-slate-400"></span>無効</span>
                <% end %>
              </td>
              <td class="px-4 py-3 text-right whitespace-nowrap">
                <%= link_to "編集", edit_admin_user_path(user), class: "btn btn-secondary" %>
                <%= button_to "削除", admin_user_path(user), method: :delete, class: "btn btn-danger",
                      form: { class: "ml-2 inline-block", onsubmit: "return confirm('このスタッフを削除しますか？')" } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="px-4 py-8 text-center text-slate-500">スタッフはまだ登録されていません。</p>
  <% end %>
</div>
