<%= form_with model: [ :admin, user ], class: "flex flex-col gap-5" do |form| %>
  <% if user.errors.any? %>
    <div class="rounded-lg border border-critical/30 bg-critical-bg px-4 py-3 text-critical-text">
      <p class="font-semibold"><%= user.errors.count %>件のエラーがあります。</p>
      <ul class="mt-1 list-disc pl-5">
        <% user.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, class: "mb-1 block font-semibold" %>
    <%= form.text_field :name, required: true, class: "input" %>
  </div>

  <div>
    <%= form.label :line_uid, class: "mb-1 block font-semibold" %>
    <%= form.text_field :line_uid, required: true, placeholder: "U1234567890abcdef1234567890abcdef", class: "input font-mono" %>
    <p class="mt-1 text-xs text-slate-500">LINEのユーザーID（「U」から始まる33文字）</p>
  </div>

  <div>
    <%= form.label :role, class: "mb-1 block font-semibold" %>
    <%= form.select :role, User.roles.keys.map { |role| [ User.human_attribute_name("role.#{role}"), role ] }, {}, class: "input" %>
  </div>

  <div class="flex items-center gap-2">
    <%= form.check_box :active, class: "size-4 accent-blue-600" %>
    <%= form.label :active %>
  </div>

  <div class="flex gap-2 pt-1">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to "キャンセル", admin_users_path, class: "btn btn-secondary" %>
  </div>
<% end %>
