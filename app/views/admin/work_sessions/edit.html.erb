<% content_for :title, "稼働予定の編集" %>

<h1 class="text-2xl font-bold">稼働予定の編集</h1>

<div class="max-w-3xl rounded-xl border border-slate-200 bg-white p-6">
  <%= render "form", work_session: @work_session %>
</div>

<% if @work_session.reports.none? %>
  <div class="max-w-3xl">
    <%= button_to "この稼働予定を削除", admin_work_session_path(@work_session), method: :delete, class: "btn btn-danger",
          form: { onsubmit: "return confirm('この稼働予定を削除しますか？')" } %>
  </div>
<% end %>
