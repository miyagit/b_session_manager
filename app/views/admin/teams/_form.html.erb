<%# locals: (team:) %>
<% staff_options = User.people.where(is_active: true).or(User.where(id: team.team_memberships.map(&:user_id).compact)).order(:name).to_a %>
<% current_quarter = Team.quarter_start(Date.current) %>
<% quarter_options = (-1..2).map { |offset| current_quarter >> (offset * Team::QUARTER_MONTHS) } %>
<% quarter_options |= [ team.starts_on ] if team.starts_on %>
<% quarter_options = quarter_options.sort.map { |starts_on| [ Team.quarter_label(starts_on), starts_on.iso8601 ] } %>

<%= form_with model: [ :admin, team ], class: "flex flex-col gap-5" do |form| %>
  <% if team.errors.any? %>
    <div class="rounded-lg border border-critical/30 bg-critical-bg px-4 py-3 text-critical-text">
      <p class="font-semibold"><%= team.errors.count %>件のエラーがあります。</p>
      <ul class="mt-1 list-disc pl-5">
        <% team.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <%= form.label :name, class: "mb-1 block font-semibold" %>
      <%= form.text_field :name, required: true, placeholder: "渡辺チーム", class: "input" %>
    </div>

    <div>
      <%= form.label :starts_on, class: "mb-1 block font-semibold" %>
      <% if team.persisted? %>
        <p class="py-2"><%= team.quarter_label %></p>
        <p class="mt-1 text-xs text-slate-500">四半期は登録後に変えられません。別の四半期には新しいチームを作ります。</p>
      <% else %>
        <%= form.select :starts_on, options_for_select(quarter_options, team.starts_on&.iso8601), {}, required: true, class: "input" %>
        <p class="mt-1 text-xs text-slate-500">チームは四半期ごとに作ります（1Q=1〜3月、2Q=4〜6月、3Q=7〜9月、4Q=10〜12月）。</p>
      <% end %>
    </div>
  </div>

  <fieldset>
    <legend class="mb-2 font-semibold">メンバーと月ごとの予算件数</legend>
    <div class="overflow-x-auto rounded-lg border border-slate-200">
      <table class="w-full min-w-160 text-[13px]">
        <thead class="bg-slate-50">
          <tr class="text-left text-xs text-slate-600">
            <th scope="col" class="px-3 py-2 font-semibold">スタッフ</th>
            <% team.months.each do |month| %>
              <th scope="col" class="px-3 py-2 text-right font-semibold whitespace-nowrap"><%= month.month %>月の予算件数</th>
            <% end %>
            <th scope="col" class="px-3 py-2 font-semibold">外す</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <%= form.fields_for :team_memberships do |membership_form| %>
            <% membership = membership_form.object %>
            <tr>
              <td class="px-3 py-2">
                <%= membership_form.collection_select :user_id, staff_options, :id, :name, { include_blank: "（選択なし）" }, class: "input min-w-32", aria: { label: "スタッフ" } %>
              </td>
              <%= membership_form.fields_for :team_targets, membership.team_targets.sort_by(&:month) do |target_form| %>
                <td class="px-3 py-2">
                  <%= target_form.hidden_field :month %>
                  <div class="flex items-center justify-end gap-1">
                    <%= target_form.number_field :budget_count, min: 0, step: 1, class: "input w-24 text-right tabular-nums", aria: { label: "#{target_form.object.month.month}月の予算件数" } %>
                    <span class="text-slate-600">件</span>
                  </div>
                </td>
              <% end %>
              <td class="px-3 py-2">
                <% if membership.persisted? %>
                  <%= membership_form.check_box :_destroy, class: "size-4 accent-blue-600", aria: { label: "このスタッフを外す" } %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <p class="mt-1 text-xs text-slate-500">スタッフを選んだ行だけが登録されます。1人が入れるチームは四半期ごとに1つです。予算件数はあとから入れても構いません（空欄は「未設定」）。人数が足りないときは、保存すると空き行が追加されます。</p>
  </fieldset>

  <div class="flex gap-2 pt-1">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to "キャンセル", (team.persisted? ? admin_team_path(team) : admin_teams_path(month: team.starts_on&.strftime("%Y-%m"))), class: "btn btn-secondary" %>
  </div>
<% end %>
