<% content_for :title, "チームの編集" %>

<h1 class="text-2xl font-bold">チームの編集</h1>

<div class="max-w-3xl rounded-xl border border-slate-200 bg-white p-6">
  <%= render "form", team: @team %>
</div>

<div class="max-w-3xl">
  <%= button_to "このチームを削除", admin_team_path(@team), method: :delete, class: "btn btn-danger",
        form: { onsubmit: "return confirm('このチームを削除しますか？メンバーの予算件数も消えます。報告や稼働予定はそのまま残ります。')" } %>
</div>
