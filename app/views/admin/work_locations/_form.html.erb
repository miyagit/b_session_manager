<%= form_with model: [ :admin, work_location ], class: "flex flex-col gap-5" do |form| %>
  <% if work_location.errors.any? %>
    <div class="rounded-lg border border-critical/30 bg-critical-bg px-4 py-3 text-critical-text">
      <p class="font-semibold"><%= work_location.errors.count %>件のエラーがあります。</p>
      <ul class="mt-1 list-disc pl-5">
        <% work_location.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, class: "mb-1 block font-semibold" %>
    <%= form.text_field :name, required: true, class: "input" %>
  </div>

  <div>
    <%= form.label :category, class: "mb-1 block font-semibold" %>
    <%= form.select :category, WorkLocation.categories.keys.map { |category| [ WorkLocation.human_attribute_name("category.#{category}"), category ] }, {}, class: "input" %>
  </div>

  <div>
    <%= form.label :budget_count, class: "mb-1 block font-semibold" do %>
      <%= WorkLocation.human_attribute_name(:budget_count) %><span class="ml-1.5 text-xs font-normal text-slate-500">任意</span>
    <% end %>
    <div class="flex max-w-48 items-center gap-2">
      <%= form.number_field :budget_count, min: 0, step: 1, class: "input text-right tabular-nums" %>
      <span class="text-slate-600">件</span>
    </div>
    <p class="mt-1 text-xs text-slate-500">まだ決まっていない場合は、空欄のままにしてください。</p>
  </div>

  <div>
    <div class="flex items-center gap-2">
      <%= form.check_box :active, class: "size-4 accent-blue-600" %>
      <%= form.label :active %>
    </div>
    <p class="mt-1 text-xs text-slate-500">使わなくなった場所は、削除せずに無効にしてください。</p>
  </div>

  <div class="flex gap-2 pt-1">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to "キャンセル", admin_work_locations_path, class: "btn btn-secondary" %>
  </div>
<% end %>
