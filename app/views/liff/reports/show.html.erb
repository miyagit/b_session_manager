<% work_session = @report.work_session %>
<% content_for :title, "報告完了" %>

<section class="rounded-xl border border-slate-200 bg-white p-5 text-center">
  <div aria-hidden="true" class="mx-auto flex size-12 items-center justify-center rounded-full bg-good-bg text-good">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-6"><path d="M20 6 9 17l-5-5"/></svg>
  </div>
  <h1 class="mt-3 text-lg font-bold">報告を受け付けました</h1>
  <p class="mt-1 text-[13px] text-slate-600">
    <%= date_with_wday(work_session.work_date) %><br>
    <%= work_session.display_name %> <%= @report.report_slot %>時の<%= Report.human_attribute_name("report_type.#{@report.report_type}") %>（<%= l(@report.reported_at, format: "%H:%M") %>）
  </p>
</section>

<section aria-label="ブース全体" class="grid grid-cols-3 gap-2">
  <% [ [ "ブース獲得", "#{@report.booth_acquired_count}件" ],
       [ "ブース予算", work_session.budget_count ? "#{work_session.budget_count}件" : "未設定" ],
       [ "達成率", format_rate(@report.achievement_rate) ] ].each do |label, value| %>
    <div class="rounded-xl border border-slate-200 bg-white px-3 py-3 text-center">
      <h2 class="text-xs font-semibold text-slate-600"><%= label %></h2>
      <p class="mt-1 text-xl font-semibold leading-tight tabular-nums"><%= value %></p>
    </div>
  <% end %>
</section>

<section class="overflow-hidden rounded-xl border border-slate-200 bg-white">
  <table class="w-full text-[13px]">
    <thead class="bg-slate-50">
      <tr class="text-left text-xs text-slate-600">
        <th scope="col" class="px-4 py-2 font-semibold">スタッフ</th>
        <th scope="col" class="px-4 py-2 text-right font-semibold"><%= @report.final? ? "獲得" : "累計獲得" %></th>
        <th scope="col" class="px-4 py-2 text-right font-semibold">アプローチ</th>
        <th scope="col" class="px-4 py-2 text-right font-semibold">カード</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% @report.report_results.each do |report_result| %>
        <tr>
          <th scope="row" class="px-4 py-2.5 text-left font-semibold"><%= report_result.work_assignment.user.name %></th>
          <td class="px-4 py-2.5 text-right font-semibold tabular-nums"><%= report_result.acquired_count %>件</td>
          <td class="px-4 py-2.5 text-right tabular-nums"><%= report_result.approach_count ? "#{report_result.approach_count}件" : "—" %></td>
          <td class="px-4 py-2.5 text-right tabular-nums"><%= report_result.card_count ? "#{report_result.card_count}件" : "—" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>

<div class="flex flex-col gap-2">
  <button type="button" id="liff-close" class="btn btn-primary w-full py-3 text-base">閉じる</button>
  <%= link_to "続けて報告する", new_liff_report_path, class: "btn btn-secondary w-full py-3 text-base" %>
</div>

<script>
  // Inside the LINE app the LIFF window can be closed; in an ordinary browser go back to the form instead.
  document.getElementById("liff-close").addEventListener("click", async () => {
    try {
      await window.liffReady;
      if (liff.isInClient()) { liff.closeWindow(); return; }
    } catch (_error) {}
    location.href = <%= raw new_liff_report_path.to_json %>;
  });
</script>
