<% work_session = @report.work_session %>
<% content_for :title, "報告完了" %>

<section class="rounded-xl border border-slate-200 bg-white p-5 text-center">
  <div aria-hidden="true" class="mx-auto flex size-12 items-center justify-center rounded-full bg-good-bg text-good">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-6"><path d="M20 6 9 17l-5-5"/></svg>
  </div>
  <h1 class="mt-3 text-lg font-bold"><%= report_heading(@report) %>を受け付けました</h1>
  <p class="mt-1 text-[13px] text-slate-600">
    <%= date_with_wday(work_session.work_date) %><br>
    <%= work_session.work_location.name %>（<%= l(@report.created_at, format: "%H:%M") %>）
  </p>
</section>

<% unless @report.start? %>
  <section aria-label="ブース全体" class="grid grid-cols-3 gap-2">
    <% [ [ "ブース獲得", "#{@report.booth_acquired_count}件" ], [ "ブース予算", work_session.budget_count ? "#{work_session.budget_count}件" : "未設定" ], [ "予算達成率", format_rate(@report.achievement_rate) ] ].each do |label, value| %>
      <div class="rounded-xl border border-slate-200 bg-white px-3 py-3 text-center">
        <h2 class="text-xs font-semibold text-slate-600"><%= label %></h2>
        <p class="mt-1 text-xl font-semibold leading-tight tabular-nums"><%= value %></p>
      </div>
    <% end %>
  </section>
<% end %>

<section class="flex flex-col gap-3">
  <% if @report.start? %>
    <% work_session.shifts.sort_by(&:id).each do |shift| %>
      <div class="rounded-xl border border-slate-200 bg-white p-4">
        <div class="flex items-baseline justify-between gap-3">
          <span class="font-semibold"><%= shift.user.name %></span>
          <span class="text-xs text-slate-500"><%= shift_type_label(shift) %></span>
        </div>
        <dl class="mt-2 grid grid-cols-2 gap-2 text-[13px]">
          <div><dt class="text-xs text-slate-500">獲得目標</dt><dd class="font-semibold tabular-nums"><%= shift.target_acquired_count ? "#{shift.target_acquired_count}件" : "未設定" %></dd></div>
          <div><dt class="text-xs text-slate-500">アプローチ目標</dt><dd class="font-semibold tabular-nums"><%= shift.target_approach_count ? "#{shift.target_approach_count}件" : "未設定" %></dd></div>
        </dl>
      </div>
    <% end %>
  <% else %>
    <% @report.report_results.each do |report_result| %>
      <% shift = report_result.shift %>
      <div class="rounded-xl border border-slate-200 bg-white p-4">
        <div class="flex items-baseline justify-between gap-3">
          <span class="font-semibold"><%= report_result.user.name %></span>
          <span class="text-xs text-slate-500"><%= shift ? shift_type_label(shift) : "" %><%= " #{report_result.hours_label}" if @report.final? && report_result.hours_label %></span>
        </div>
        <dl class="mt-2 grid grid-cols-2 gap-2 text-[13px]">
          <div>
            <dt class="text-xs text-slate-500"><%= @report.final? ? "獲得件数" : "累計獲得" %></dt>
            <dd class="tabular-nums"><span class="font-semibold"><%= report_result.acquired_count %>件</span><% if shift&.target_acquired_count %> / 目標<%= shift.target_acquired_count %>件（<%= format_rate(report_result.acquired_rate) %>）<% end %></dd>
          </div>
          <div>
            <dt class="text-xs text-slate-500">アプローチ</dt>
            <dd class="tabular-nums"><span class="font-semibold"><%= report_result.approach_count %>件</span><% if shift&.target_approach_count %> / 目標<%= shift.target_approach_count %>件（<%= format_rate(report_result.approach_rate) %>）<% end %></dd>
          </div>
          <% if @report.final? %>
            <div>
              <dt class="text-xs text-slate-500">カード</dt>
              <dd class="tabular-nums"><span class="font-semibold"><%= report_result.card_count %>件</span>・カード率 <%= format_rate(report_result.card_rate) %></dd>
            </div>
          <% end %>
        </dl>
      </div>
    <% end %>
  <% end %>
</section>

<section class="rounded-xl border border-slate-200 bg-white p-4">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <h2 class="text-base font-bold">実績報告グループへの投稿</h2>
    <%= delivery_status_badge(@report.line_message_delivery) %>
  </div>
  <% if @report.line_message_delivery&.sent? %>
    <p class="mt-2 text-[13px] text-slate-600">この報告はすでに投稿済みです。</p>
  <% else %>
    <p class="mt-2 text-[13px] text-slate-600">グループのノートから開いた場合は、このまま自動でグループに投稿されます。それ以外から開いた場合は、下のボタンで送信先を選んで投稿してください。どちらもあなたの発言として投稿されます。</p>
    <button type="button" id="liff-post" hidden class="btn btn-primary mt-3 w-full py-3 text-base">LINEグループに投稿</button>
    <p id="liff-post-status" role="status" class="mt-2 text-[13px] text-slate-600"></p>
  <% end %>
  <details class="mt-3 text-[13px]">
    <summary class="cursor-pointer font-semibold text-slate-700">投稿文を表示</summary>
    <pre class="mt-2 whitespace-pre-wrap rounded-lg bg-slate-50 p-3 font-sans leading-relaxed"><%= @line_message %></pre>
  </details>
</section>

<div class="flex flex-col gap-2">
  <button type="button" id="liff-close" class="btn btn-secondary w-full py-3 text-base">閉じる</button>
  <%= link_to "続けて報告する", new_liff_report_path(work_session_id: work_session), class: "btn btn-secondary w-full py-3 text-base" %>
</div>

<script>
  // Posting to the report group as the staff member (free, no push quota). Opened from the group itself, the
  // report is sent there automatically as soon as this page loads; otherwise a button opens LINE's share target
  // picker. The server is told afterwards so the delivery shows as sent.
  (async () => {
    const button = document.getElementById("liff-post");
    if (!button) return;
    const status = document.getElementById("liff-post-status");
    const text = <%= raw @line_message.to_json %>;
    const markUrl = <%= raw liff_report_line_delivery_path(@report).to_json %>;
    const postedKey = "liffPosted:" + <%= @report.id %>;
    const alreadyPosted = () => { try { return sessionStorage.getItem(postedKey) === "1"; } catch (_error) { return false; } };
    const rememberPosted = () => { try { sessionStorage.setItem(postedKey, "1"); } catch (_error) {} };

    try {
      await window.liffReady;
    } catch (_error) {
      return;
    }
    const inChat = liff.isInClient() && ["group", "room"].includes(liff.getContext()?.type);

    const markPosted = () => fetch(markUrl, {
      method: "POST",
      headers: { "Accept": "application/json", "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').content }
    });
    const done = () => { rememberPosted(); button.hidden = true; status.textContent = "LINEに投稿しました。"; };
    const fail = (error) => {
      button.hidden = false;
      button.disabled = false;
      status.textContent = `投稿できませんでした（${error.message}）。ボタンからもう一度お試しください。`;
    };
    const sendToChat = async () => { await liff.sendMessages([{ type: "text", text }]); await markPosted(); done(); };
    const sendViaPicker = async () => {
      const result = await liff.shareTargetPicker([{ type: "text", text }], { isMultiple: false });
      if (!result) { button.disabled = false; return; } // cancelled
      await markPosted();
      done();
    };

    if (inChat) {
      button.textContent = "このグループに投稿";
      if (alreadyPosted()) { status.textContent = "LINEに投稿済みです。"; return; }
      status.textContent = "グループに投稿しています…";
      try { await sendToChat(); } catch (error) { fail(error); }
    } else if (liff.isApiAvailable("shareTargetPicker")) {
      button.hidden = false;
    } else {
      return;
    }

    button.addEventListener("click", async () => {
      button.disabled = true;
      status.textContent = "";
      try {
        if (inChat) { await sendToChat(); } else { await sendViaPicker(); }
      } catch (error) {
        fail(error);
      }
    });
  })();

  // Inside the LINE app the LIFF window can be closed; in an ordinary browser go back to the form instead.
  document.getElementById("liff-close").addEventListener("click", async () => {
    try {
      await window.liffReady;
      if (liff.isInClient()) { liff.closeWindow(); return; }
    } catch (_error) {}
    location.href = <%= raw new_liff_report_path.to_json %>;
  });
</script>
