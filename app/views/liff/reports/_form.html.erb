<%# locals: (report:, work_session:, result_rows:, work_sessions:) %>
<section class="rounded-xl border border-slate-200 bg-white p-4">
  <div class="flex items-start justify-between gap-3">
    <div>
      <p class="text-xs text-slate-500"><%= date_with_wday(work_session.work_date) %></p>
      <h1 class="mt-0.5 text-lg font-bold"><%= work_session.work_location.name %></h1>
    </div>
    <% if work_sessions.size > 1 %>
      <%= link_to "ブースを変更", new_liff_report_path, class: "btn btn-secondary shrink-0" %>
    <% end %>
  </div>
  <%= render "reports/session_summary", work_session: work_session %>
</section>

<%= form_with model: report, url: liff_reports_path, class: "report-form flex flex-col gap-5" do |form| %>
  <%= form.hidden_field :work_session_id %>
  <%= render "reports/form_errors", report: report, work_session: work_session %>

  <%= render "reports/choice_fields", form: form, work_session: work_session %>
  <%= render "reports/audience_field", form: form, work_session: work_session %>

  <fieldset>
    <legend class="mb-2 font-semibold">スタッフ別</legend>
    <div class="flex flex-col gap-3">
      <%= form.fields_for :report_results, result_rows do |result_form| %>
        <%= render "reports/staff_fields", result_form: result_form, shift: work_session.shift_for(result_form.object.user_id), own: result_form.object.user_id == current_staff.id %>
      <% end %>
    </div>
    <p class="mt-1.5 text-xs text-slate-500">自分の分だけ入力すれば報告できます。ほかの人の欄は触らなくて構いません（まとめて入れることもできます）。開始報告は目標を入力・変更した人、途中・最終報告は獲得件数を入力した人が対象になり、最終報告はカード数と勤務時間も必要です。シネマの「他社」は件数だけ入力でき、空欄なら報告されません。</p>
  </fieldset>

  <%= form.submit "報告する", class: "btn btn-primary w-full py-3 text-base" %>
<% end %>
