<%# locals: (report:, work_session:, result_rows:, work_sessions:) %>
<% registered_reports = work_session.reports.select(&:persisted?).sort_by(&:report_slot) %>
<% choice_classes = "flex min-h-14 cursor-pointer flex-col items-center justify-center rounded-lg border border-slate-200 bg-white px-1 py-2 text-center font-semibold has-checked:border-blue-600 has-checked:bg-blue-50 has-checked:text-blue-700 has-focus-visible:outline-2 has-focus-visible:outline-blue-600 has-disabled:cursor-not-allowed has-disabled:bg-slate-50 has-disabled:text-slate-400" %>

<section class="rounded-xl border border-slate-200 bg-white p-4">
  <div class="flex items-start justify-between gap-3">
    <div>
      <p class="text-xs text-slate-500"><%= date_with_wday(work_session.work_date) %></p>
      <h1 class="mt-0.5 text-lg font-bold"><%= work_session.display_name %></h1>
    </div>
    <% if work_sessions.size > 1 %>
      <%= link_to "ブースを変更", new_liff_report_path, class: "btn btn-secondary shrink-0" %>
    <% end %>
  </div>
  <dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[13px]">
    <dt class="text-slate-500">ブース予算</dt>
    <dd class="tabular-nums"><%= work_session.budget_count ? "#{work_session.budget_count}件" : "未設定" %></dd>
    <dt class="text-slate-500">報告済み</dt>
    <dd class="flex flex-wrap gap-1.5">
      <% if registered_reports.empty? %>
        まだありません
      <% else %>
        <% registered_reports.each do |registered_report| %>
          <%= status_badge("#{registered_report.report_slot}時 #{Report.human_attribute_name("report_type.#{registered_report.report_type}")}", registered_report.final? ? :good : :warning) %>
        <% end %>
      <% end %>
    </dd>
  </dl>
</section>

<%= form_with model: report, url: liff_reports_path, class: "flex flex-col gap-5" do |form| %>
  <%= form.hidden_field :work_session_id %>

  <% if report.errors.any? %>
    <div class="rounded-lg border border-critical/30 bg-critical-bg px-4 py-3 text-critical-text">
      <p class="font-semibold"><%= report.errors.count %>件のエラーがあります。</p>
      <ul class="mt-1 list-disc pl-5">
        <% report.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <fieldset>
    <legend class="mb-2 font-semibold"><%= Report.human_attribute_name(:report_slot) %></legend>
    <div class="grid grid-cols-4 gap-2">
      <% Report::SLOTS.each do |slot| %>
        <% registered = registered_reports.any? { |registered_report| registered_report.report_slot == slot } %>
        <label class="<%= choice_classes %>">
          <%= form.radio_button :report_slot, slot, disabled: registered, class: "sr-only" %>
          <%= slot %>時
          <% if registered %><span class="text-[10px] font-normal">報告済み</span><% end %>
        </label>
      <% end %>
    </div>
  </fieldset>

  <fieldset>
    <legend class="mb-2 font-semibold"><%= Report.human_attribute_name(:report_type) %></legend>
    <div class="grid grid-cols-2 gap-2">
      <% Report.report_types.each_key do |report_type| %>
        <label class="<%= choice_classes %>">
          <%= form.radio_button :report_type, report_type, class: "sr-only" %>
          <%= Report.human_attribute_name("report_type.#{report_type}") %>
        </label>
      <% end %>
    </div>
    <p class="mt-1.5 text-xs text-slate-500">中間報告はその時点までの累計件数、最終報告はその日の確定件数を入力します。</p>
  </fieldset>

  <fieldset>
    <legend class="mb-2 font-semibold">スタッフ別の件数</legend>
    <div class="flex flex-col gap-3">
      <%= form.fields_for :report_results, result_rows do |result_form| %>
        <% work_assignment = result_form.object.work_assignment %>
        <% staff_name = work_assignment.user.name %>
        <div class="rounded-xl border border-slate-200 bg-white p-4">
          <div class="flex items-baseline justify-between gap-3">
            <span class="font-semibold">
              <%= staff_name %>
              <% if work_assignment.user_id == current_staff.id %>
                <span class="ml-1 rounded-full bg-blue-50 px-2 py-0.5 text-[11px] font-semibold text-blue-700">あなた</span>
              <% end %>
            </span>
            <span class="text-xs text-slate-500">個人目標 <%= work_assignment.target_count %>件</span>
          </div>
          <%= result_form.hidden_field :work_assignment_id %>
          <div class="mt-3 grid grid-cols-3 gap-2">
            <% [ [ :acquired_count, "獲得件数", false ], [ :approach_count, "アプローチ", true ], [ :card_count, "カード", true ] ].each do |attribute, label, optional| %>
              <label class="block">
                <span class="text-xs text-slate-600"><%= label %><% if optional %><span class="ml-1 text-slate-400">任意</span><% end %></span>
                <%= result_form.number_field attribute, min: 0, step: 1, inputmode: "numeric", class: "input mt-1 text-right text-base tabular-nums", aria: { label: "#{staff_name}の#{label}" } %>
              </label>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
    <p class="mt-1.5 text-xs text-slate-500">獲得件数を入力したスタッフだけが報告されます（1回の報告につき最大<%= Report::MAX_RESULTS %>名）。</p>
  </fieldset>

  <%= form.submit "報告する", class: "btn btn-primary w-full py-3 text-base" %>
<% end %>
