<%# locals: (work_sessions:) %>
<% if work_sessions.empty? %>
  <section class="rounded-xl border border-slate-200 bg-white px-4 py-8 text-center">
    <p class="font-semibold">今日の稼働予定に割り当てられていません。</p>
    <p class="mt-1 text-xs text-slate-500">稼働予定の登録は管理者が行います。心当たりがある場合は管理者に確認してください。</p>
  </section>
<% else %>
  <h1 class="text-lg font-bold">どのブースの報告ですか？</h1>
  <ul class="flex flex-col gap-3">
    <% work_sessions.each do |work_session| %>
      <% registered_slots = work_session.reports.map(&:report_slot).sort %>
      <li class="rounded-xl border border-slate-200 bg-white p-4">
        <p class="text-xs text-slate-500"><%= date_with_wday(work_session.work_date) %></p>
        <h2 class="mt-0.5 text-base font-bold"><%= work_session.display_name %></h2>
        <p class="mt-1 text-[13px] text-slate-600">
          <%= work_session.work_assignments.sort_by(&:id).map { |work_assignment| work_assignment.user.name }.join("、") %>
          ・ブース予算 <%= work_session.budget_count ? "#{work_session.budget_count}件" : "未設定" %>
        </p>
        <div class="mt-3 flex items-center justify-between gap-3">
          <span class="flex flex-wrap items-center gap-1.5">
            <%= result_status_badge(work_session.result_status) %>
            <% if registered_slots.any? %>
              <span class="text-xs text-slate-500"><%= registered_slots.map { |slot| "#{slot}時" }.join("・") %> 報告済み</span>
            <% end %>
          </span>
          <% if (Report::SLOTS - registered_slots).any? %>
            <%= link_to "このブースで報告", new_liff_report_path(work_session_id: work_session), class: "btn btn-primary shrink-0" %>
          <% else %>
            <span class="shrink-0 text-[13px] text-slate-500">全時間帯報告済み</span>
          <% end %>
        </div>
      </li>
    <% end %>
  </ul>
<% end %>
