<%# locals: (work_locations:, booth_days:) %>
<div>
  <h1 class="text-lg font-bold">どのブースの報告ですか？</h1>
  <p class="mt-1 text-xs text-slate-500"><%= date_with_wday(Date.current) %>の報告として登録されます。</p>
</div>

<% WorkLocation.categories.each_key do |category| %>
  <% category_locations = work_locations.select { |work_location| work_location.category == category } %>
  <% next if category_locations.empty? %>
  <section>
    <h2 class="mb-2 text-xs font-semibold text-slate-500"><%= WorkLocation.human_attribute_name("category.#{category}") %></h2>
    <ul class="flex flex-col gap-2">
      <% category_locations.each do |work_location| %>
        <% booth_day = booth_days[work_location.id] %>
        <% registered_slots = booth_day ? booth_day.reports.map(&:report_slot) : [] %>
        <li class="flex items-center justify-between gap-3 rounded-xl border border-slate-200 bg-white px-4 py-3">
          <div class="min-w-0">
            <h3 class="truncate font-bold"><%= work_location.name %></h3>
            <p class="mt-1 flex flex-wrap items-center gap-1.5 text-xs text-slate-500">
              <%= result_status_badge(booth_day ? booth_day.result_status : :none) %>
              <% if registered_slots.any? %>
                <span><%= registered_slots.map { |slot| "#{slot}時" }.join("・") %> 報告済み</span>
              <% end %>
            </p>
          </div>
          <% if (Report::SLOTS - registered_slots).any? %>
            <%= link_to "報告する", new_liff_report_path(work_location_id: work_location), class: "btn btn-primary shrink-0" %>
          <% else %>
            <span class="shrink-0 text-xs text-slate-500">全時間帯報告済み</span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
