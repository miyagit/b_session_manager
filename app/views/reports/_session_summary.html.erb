<%# locals: (work_session:) %>
<%# The booth day a report is filed for, with what has already been reported. %>
<dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[13px]">
  <dt class="text-slate-500">ブース予算</dt>
  <dd class="tabular-nums"><%= work_session.budget_count ? "#{work_session.budget_count}件" : "未設定" %></dd>
  <dt class="text-slate-500">スタッフ</dt>
  <dd><%= work_session.shifts.sort_by(&:id).map { |shift| "#{shift.user.name}（#{shift_type_label(shift)}）" }.join("、") %></dd>
  <dt class="text-slate-500">報告済み</dt>
  <dd class="flex flex-wrap gap-1.5">
    <% reports = work_session.reports.select(&:persisted?).sort_by { |report| [ report.start? ? 0 : (report.interim? ? 1 : 2), report.report_slot.to_i ] } %>
    <% if reports.empty? %>
      まだありません
    <% else %>
      <% reports.each do |report| %><%= report_badge(report) %><% end %>
    <% end %>
  </dd>
</dl>
