<%# locals: (form:, work_session:, slot_hint: nil) %>
<%# Report type, then the time slot (interim reports only; hidden by the .report-form CSS otherwise). Reports are per
    person, so a type or slot somebody already filed stays selectable; the small label says who filed it. %>
<% choice_classes = "flex min-h-14 cursor-pointer flex-col items-center justify-center rounded-lg border border-slate-200 bg-white px-1 py-2 text-center font-semibold has-checked:border-blue-600 has-checked:bg-blue-50 has-checked:text-blue-700 has-focus-visible:outline-2 has-focus-visible:outline-blue-600" %>
<% filed = work_session.reports.select(&:persisted?) %>
<% filed_by = ->(reports) { reports.map { |report| report.submitted_by.name }.uniq.join("・") } %>

<fieldset>
  <legend class="mb-2 font-semibold"><%= Report.human_attribute_name(:report_type) %></legend>
  <div class="grid grid-cols-3 gap-2">
    <% Report.report_types.each_key do |report_type| %>
      <% reports = filed.select { |report| report.report_type == report_type } %>
      <label class="<%= choice_classes %>">
        <%= form.radio_button :report_type, report_type, class: "sr-only" %>
        <%= Report.human_attribute_name("report_type.#{report_type}") %>
        <% if reports.any? %><span class="text-[10px] font-normal text-slate-500"><%= filed_by.(reports) %> 済</span><% end %>
      </label>
    <% end %>
  </div>
  <p class="mt-1.5 text-xs text-slate-500">開始報告は目標の入力、途中報告はその時点までの累計件数、最終報告はその日の確定件数と勤務時間です。報告は人ごとなので、ほかの人が報告済みでも自分の分を送れます。</p>
</fieldset>

<fieldset class="interim-only">
  <legend class="mb-2 font-semibold"><%= Report.human_attribute_name(:report_slot) %></legend>
  <div class="grid grid-cols-3 gap-2">
    <% Report::INTERIM_SLOTS.each do |slot| %>
      <% reports = filed.select { |report| report.interim? && report.report_slot == slot } %>
      <label class="<%= choice_classes %>">
        <%= form.radio_button :report_slot, slot, class: "sr-only" %>
        <%= slot %>時
        <% if reports.any? %><span class="text-[10px] font-normal text-slate-500"><%= filed_by.(reports) %> 済</span><% end %>
      </label>
    <% end %>
  </div>
  <% if slot_hint %><p class="mt-1.5 text-xs text-slate-500"><%= slot_hint %></p><% end %>
</fieldset>
