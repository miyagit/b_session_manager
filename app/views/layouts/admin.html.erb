<!DOCTYPE html>
<html lang="ja">
  <head>
    <title><%= content_for(:title) || "管理画面" %> | B Session Manager</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%= stylesheet_link_tag "tailwind" %>
  </head>

  <body class="min-h-screen bg-slate-50 font-sans text-sm text-slate-900 antialiased">
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto flex min-h-15 max-w-7xl flex-wrap items-center gap-x-7 gap-y-1 px-6">
        <%= link_to admin_root_path, class: "flex items-center gap-2.5 text-[15px] font-bold" do %>
          <span aria-hidden="true" class="flex size-7 items-center justify-center rounded-lg bg-slate-900 text-white">B</span>
          B Session Manager
        <% end %>

        <% if admin_user_signed_in? %>
          <nav aria-label="メインメニュー" class="flex gap-1">
            <%= link_to "スタッフ", admin_users_path, class: "border-b-2 border-blue-600 px-2.5 py-4.5 font-semibold" %>
          </nav>

          <div class="ml-auto flex items-center gap-3 py-2.5">
            <span class="text-[13px] text-slate-500"><%= current_admin_user.email %></span>
            <%= button_to "ログアウト", destroy_admin_user_session_path, method: :delete, class: "btn btn-secondary" %>
          </div>
        <% end %>
      </div>
    </header>

    <main class="mx-auto flex max-w-7xl flex-col gap-6 px-6 pt-7 pb-12">
      <% if notice %>
        <p class="rounded-lg bg-good-bg px-4 py-2.5 text-good-text"><%= notice %></p>
      <% end %>
      <% if alert %>
        <p class="rounded-lg bg-critical-bg px-4 py-2.5 text-critical-text"><%= alert %></p>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
