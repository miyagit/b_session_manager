<!DOCTYPE html>
<html lang="ja">
  <head>
    <title><%= content_for(:title) || "実績報告" %> | B Session Manager</title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="robots" content="noindex">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%= stylesheet_link_tag "tailwind" %>
    <script charset="utf-8" src="https://static.line-scdn.net/liff/edge/2/sdk.js"></script>
    <script>
      // LIFF is initialized once per page. Pages `await window.liffReady` before calling other liff.* functions.
      window.liffReady = (async () => {
        const liffId = <%= raw liff_id.to_json %>;
        if (!liffId) throw new Error("LIFF IDが設定されていません。");
        if (!/^\d+-\w+$/.test(liffId)) throw new Error("LIFF IDの形式が正しくありません（例: 1234567890-AbCdEfGh）。チャネルIDではなく LIFF ID を設定してください。");
        await liff.init({ liffId });
      })();
      window.liffReady.catch(() => {});
    </script>
  </head>

  <body class="min-h-screen bg-slate-50 font-sans text-sm text-slate-900 antialiased">
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto flex min-h-13 max-w-lg items-center justify-between gap-3 px-4">
        <span class="flex items-center gap-2 font-bold">
          <span aria-hidden="true" class="flex size-6 items-center justify-center rounded-md bg-slate-900 text-xs text-white">B</span>
          実績報告
        </span>
        <% if current_staff %>
          <span class="flex items-center gap-2 text-[13px] text-slate-500">
            <%= current_staff.name %>
            <% if Rails.env.development? %>
              <%= button_to "切替", liff_session_path, method: :delete, class: "btn btn-secondary px-2 py-1 text-xs" %>
            <% end %>
          </span>
        <% end %>
      </div>
    </header>

    <main class="mx-auto flex max-w-lg flex-col gap-4 px-4 pt-4 pb-10">
      <% if notice %>
        <p class="rounded-lg bg-good-bg px-4 py-2.5 text-good-text"><%= notice %></p>
      <% end %>
      <% if alert %>
        <p class="rounded-lg bg-critical-bg px-4 py-2.5 text-critical-text"><%= alert %></p>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
